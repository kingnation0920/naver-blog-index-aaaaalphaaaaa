---
import { getCollection } from 'astro:content';
import ArticleList from '@/components/ArticleList.astro';
import ConsultationCTA from '@/components/ConsultationCTA.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categoryMeta, sortNewestFirst, type Category } from '@/lib/content';

const articles = sortNewestFirst(await getCollection('articles'));
const featured = articles.find((article) => article.data.featured) ?? articles[0];
const topicCopy: Record<Exclude<Category, 'notes'>, { title: string; description: string }> = {
  work: { title: '일과 번아웃', description: '성과와 책임 사이에서 지친 마음의 신호를 읽습니다.' },
  relationships: { title: '관계와 회복', description: '가까운 사이에서 반복되는 거리와 연결을 살펴봅니다.' },
  family: { title: '가족과 성장', description: '오래된 역할과 대화 안에서 새로운 선택을 찾습니다.' }
};
const topics = Object.entries(topicCopy) as [Exclude<Category, 'notes'>, { title: string; description: string }][];
---

<BaseLayout title={site.name} description={site.description} pathname="/">
  <Header />
  <main id="main-content">
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow">Psychology archive · Seoul</p>
        <h1>삶이 흔들릴 때,<br />마음을 읽는 기준</h1>
        <p class="hero-intro">{site.description}</p>
        <a class="button button--primary" href="#latest">글 둘러보기</a>
      </div>
      <aside class="weekly-index" aria-labelledby="weekly-title">
        <p class="eyebrow" id="weekly-title">이번 주의 색인</p>
        {articles.slice(0, 3).map((article, index) => (
          <a href={`/articles/${article.id}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{article.data.title}</strong>
          </a>
        ))}
      </aside>
    </section>

    <section class="topics container" aria-labelledby="topics-title">
      <p class="eyebrow">Life index</p>
      <div class="section-heading">
        <h2 id="topics-title">삶의 세 영역</h2>
        <p>문제가 아니라 장면에서 시작합니다. 지금 마음에 가까운 영역을 골라 읽어보세요.</p>
      </div>
      <div class="topic-grid">
        {topics.map(([key, copy], index) => (
          <a href={categoryMeta[key].route}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{copy.title}</h3>
            <p>{copy.description}</p>
            <small>기록 보기 →</small>
          </a>
        ))}
      </div>
    </section>

    {featured && (
      <section class="featured-wrap">
        <article class="featured container">
          <div>
            <p class="eyebrow">Editor's selection</p>
            <span class="featured-number" aria-hidden="true">01</span>
          </div>
          <div>
            <p class="featured-category">{categoryMeta[featured.data.category].label}</p>
            <h2><a href={`/articles/${featured.id}`}>{featured.data.title}</a></h2>
            <p>{featured.data.summary}</p>
            <a class="text-link" href={`/articles/${featured.id}`}>이 장면 읽기 →</a>
          </div>
        </article>
      </section>
    )}

    <section class="latest container" id="latest" aria-labelledby="latest-title">
      <p class="eyebrow">Latest archive</p>
      <div class="section-heading">
        <h2 id="latest-title">최근 마음의 장면</h2>
        <a href={categoryMeta.notes.route}>마음 기록 보기 →</a>
      </div>
      <ArticleList articles={articles} />
    </section>

    <blockquote class="quote container">
      <span aria-hidden="true">“</span>
      <p>마음을 이해하는 일은 정답을 찾는 일이 아니라, 반복되는 장면에 이름을 붙이는 일입니다.</p>
    </blockquote>

    <div class="consultation container"><ConsultationCTA /></div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(280px, .55fr); gap: clamp(40px, 8vw, 112px); align-items: end; min-height: min(760px, calc(100vh - 76px)); padding-block: clamp(80px, 12vw, 156px) clamp(64px, 9vw, 112px); }
  .hero h1 { max-width: 11ch; margin: 18px 0 30px; font-size: clamp(3.25rem, 8vw, 7rem); line-height: .98; }
  .hero-intro { max-width: 52ch; margin-bottom: 34px; color: var(--muted); font-size: clamp(1rem, 1.6vw, 1.16rem); }
  .weekly-index { padding: 30px; border: 1px solid var(--line); background: var(--surface); }
  .weekly-index > a { display: grid; grid-template-columns: 34px 1fr; gap: 12px; padding-block: 18px; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .weekly-index > a span { color: var(--accent); font-size: .76rem; }
  .weekly-index > a strong { font-size: .93rem; font-weight: 550; line-height: 1.45; }
  .topics, .latest, .consultation { padding-block: var(--section-space); }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .7fr); gap: 40px; align-items: end; margin-bottom: clamp(34px, 5vw, 60px); }
  .section-heading h2 { margin-bottom: 0; font-size: clamp(2.25rem, 5vw, 4.6rem); }
  .section-heading p, .section-heading > a { margin-bottom: 0; color: var(--muted); }
  .section-heading > a { justify-self: end; }
  .topic-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--line); }
  .topic-grid > a { display: flex; min-height: 310px; flex-direction: column; padding: clamp(25px, 4vw, 44px); border-right: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .topic-grid > a:last-child { border-right: 0; }
  .topic-grid > a:hover { background: var(--surface); }
  .topic-grid span, .featured-category, .topic-grid small { color: var(--accent); font-size: .75rem; letter-spacing: .08em; }
  .topic-grid h3 { margin: 54px 0 16px; font-size: clamp(1.45rem, 3vw, 2.25rem); }
  .topic-grid p { color: var(--muted); }
  .topic-grid small { margin-top: auto; }
  .featured-wrap { padding-block: var(--section-space); color: #dfe8e1; background: var(--dark); }
  .featured { display: grid; grid-template-columns: minmax(150px, .45fr) minmax(0, 1.55fr); gap: clamp(36px, 8vw, 120px); }
  .featured .eyebrow { color: #d89a7c; }
  .featured-number { display: block; margin-top: clamp(60px, 12vw, 150px); color: #61756a; font-size: clamp(4rem, 11vw, 9rem); line-height: 1; }
  .featured h2 { max-width: 13ch; margin: 22px 0 24px; color: white; font-size: clamp(2.5rem, 6vw, 5.6rem); }
  .featured h2 a { color: inherit; text-decoration: none; }
  .featured > div:last-child > p { max-width: 56ch; color: #bdc9c1; }
  .featured .text-link { display: inline-block; margin-top: 24px; color: white; }
  .quote { display: grid; grid-template-columns: auto 1fr; gap: clamp(18px, 4vw, 48px); padding-block: var(--section-space); border-top: 1px solid var(--line); }
  .quote span { color: var(--accent); font-size: clamp(4rem, 9vw, 8rem); line-height: .8; }
  .quote p { max-width: 22ch; margin: 0; color: var(--ink); font-size: clamp(1.8rem, 4.5vw, 4rem); font-weight: 550; letter-spacing: -.04em; line-height: 1.3; }
  @media (max-width: 800px) {
    .hero, .section-heading, .featured { grid-template-columns: 1fr; }
    .hero { min-height: auto; }
    .section-heading > a { justify-self: start; }
    .topic-grid { grid-template-columns: 1fr; }
    .topic-grid > a { min-height: 240px; border-right: 0; border-bottom: 1px solid var(--line); }
    .topic-grid > a:last-child { border-bottom: 0; }
    .featured-number { display: none; }
  }
</style>

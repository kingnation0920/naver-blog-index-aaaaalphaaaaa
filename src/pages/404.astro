---
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="페이지를 찾을 수 없습니다"
  description="요청한 페이지가 없거나 이동했습니다."
  pathname="/404"
>
  <Header />
  <main id="main-content" class="not-found container">
    <p class="eyebrow">Error · 404</p>
    <span aria-hidden="true">404</span>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p>주소를 확인하거나 감정 아카이브의 최신 글로 돌아가세요.</p>
    <a class="button button--primary" href="/">홈으로 돌아가기</a>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found { position: relative; min-height: 70vh; padding-block: clamp(80px, 14vw, 170px); overflow: hidden; }
  .not-found > span { position: absolute; z-index: -1; top: 20px; right: 0; color: color-mix(in srgb, var(--accent) 10%, transparent); font-size: clamp(9rem, 34vw, 28rem); font-weight: 700; line-height: 1; }
  h1 { max-width: 12ch; margin: 20px 0 28px; font-size: clamp(3rem, 8vw, 6.8rem); }
  .not-found > p:not(.eyebrow) { max-width: 48ch; color: var(--muted); }
  .button { margin-top: 20px; }
</style>

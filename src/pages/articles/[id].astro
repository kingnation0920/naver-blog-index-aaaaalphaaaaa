---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleList from '@/components/ArticleList.astro';
import ConsultationCTA from '@/components/ConsultationCTA.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import { site } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categoryMeta } from '@/lib/content';

export async function getStaticPaths() {
  return (await getCollection('articles')).map((entry) => ({
    params: { id: entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'articles'> };
const { Content } = await render(entry);
const allArticles = await getCollection('articles');
const related = entry.data.relatedSlugs
  .map((id) => allArticles.find((article) => article.id === id))
  .filter((article): article is CollectionEntry<'articles'> => Boolean(article));
const pathname = `/articles/${entry.id}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.publishedAt.toISOString(),
  author: { '@type': 'Organization', name: site.operator },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(pathname, site.url).href
};
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  pathname={pathname}
  image={entry.data.shareImage}
  jsonLd={jsonLd}
>
  <Header />
  <main id="main-content" class="article-page container">
    <header>
      <a class="article-category" href={categoryMeta[entry.data.category].route}>
        {categoryMeta[entry.data.category].label}
      </a>
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <small>{entry.data.readingTime} · {entry.data.publishedAt.toLocaleDateString('ko-KR')}</small>
    </header>

    <article class="prose"><Content /></article>

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <p class="eyebrow">Related scenes</p>
        <h2 id="related-title">이어 읽기</h2>
        <ArticleList articles={related} />
      </section>
    )}

    <ConsultationCTA />
  </main>
  <Footer />
</BaseLayout>

<style>
  .article-page > header {
    max-width: 920px;
    padding-block: clamp(76px, 12vw, 150px) clamp(56px, 8vw, 96px);
    border-bottom: 1px solid var(--line);
  }

  .article-category {
    color: var(--accent);
    font-size: .8rem;
    font-weight: 650;
    letter-spacing: .1em;
    text-decoration: none;
  }

  h1 {
    max-width: 13ch;
    margin: 22px 0 30px;
    font-size: clamp(2.8rem, 7.5vw, 6.5rem);
  }

  header > p {
    max-width: 54ch;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
  }

  header small {
    color: var(--muted);
  }

  .prose {
    width: min(100%, 720px);
    margin-inline: auto;
    padding-block: clamp(58px, 10vw, 120px);
    color: var(--body);
    font-size: clamp(1.04rem, 1.6vw, 1.18rem);
    line-height: 1.95;
  }

  .prose :global(p) {
    margin-bottom: 1.8em;
    overflow-wrap: anywhere;
  }

  .related {
    padding-block: clamp(56px, 9vw, 106px);
    border-top: 1px solid var(--line);
  }

  .related h2 {
    margin-bottom: 34px;
    font-size: clamp(2rem, 4vw, 3.6rem);
  }

  .article-page > :global(.consultation-cta) {
    margin-bottom: var(--section-space);
  }
</style>
